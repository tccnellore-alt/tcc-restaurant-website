# Copy to .env and fill values. Never commit .env.
PORT=8787
HOST=0.0.0.0
DATA_DIR=C:/ProgramData/TCC/OrderServer
# Optional absolute database path; otherwise DATA_DIR/tcc-orders.sqlite
# DB_PATH=
# Set both paths to enable HTTPS. Use a browser-trusted certificate for LAN split-DNS.
# HTTPS_KEY_PATH=C:/ProgramData/TCC/OrderServer/tls/privkey.pem
# HTTPS_CERT_PATH=C:/ProgramData/TCC/OrderServer/tls/fullchain.pem
TCC_LOCAL_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
ALLOWED_ORIGIN=https://tcc-restaurant-website.pages.dev
SUPABASE_URL=https://pcxsdypqlavtulidpydn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
QR_SYNC_INTERVAL_MS=60000
# Development default; for HTTPS split-DNS use the trusted hostname, e.g. https://orders.your-domain.example
LOCAL_SERVER_URL=http://127.0.0.1:8787
BACKUP_DIR=C:/ProgramData/TCC/OrderServer/backups
BACKUP_RETENTION_DAYS=14
